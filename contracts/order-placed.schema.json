{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "order-placed.schema.json",
  "title": "OrderPlaced",
  "description": "Published by the Order service (routing key order.placed). Consumed by the Inventory service.",
  "type": "object",
  "required": ["eventId", "type", "version", "occurredAt", "correlationId", "data"],
  "additionalProperties": false,
  "properties": {
    "eventId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "type": { "const": "OrderPlaced" },
    "version": { "const": 1 },
    "occurredAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "correlationId": { "type": "string", "minLength": 8, "maxLength": 100 },
    "data": {
      "type": "object",
      "required": ["orderId", "customerId", "items"],
      "additionalProperties": false,
      "properties": {
        "orderId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["sku", "quantity"],
            "additionalProperties": false,
            "properties": {
              "sku": { "type": "string", "minLength": 3, "maxLength": 40 },
              "quantity": { "type": "integer", "minimum": 1, "maximum": 100 }
            }
          }
        }
      }
    }
  }
}